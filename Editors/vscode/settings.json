{
    "workbench.startupEditor": "none",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "explorer.confirmDelete": false,
    "editor.inlineSuggest.enabled": true,
    "dotnet.autoDetect": "off",
    "git.autofetch": true,
    "dotnetAcquisitionExtension.existingDotnetPath": [],
    "dotnet.preferRuntimeFromSDK": true,
    "vim.statusBarColorControl": true,
    "editor.minimap.renderCharacters": false,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "azureFunctions.showProjectWarning": false,
    "vim.highlightedyank.enable": true,
    "vim.leader": " ",
    "git.openRepositoryInParentFolders": "never",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "explorer.confirmDragAndDrop": false,
    "editor.lineNumbers": "relative",
    "vim.hlsearch": true,
    "vim.useSystemClipboard": true,
    "vim.normalModeKeyBindings": [
        {
            "before": [
                "K"
            ],
            "commands": [
                "editor.action.showHover"
            ],
        },
        {
            "before": [
                "leader",
                "c",
                "a"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "leader",
                "r",
                "r"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "leader",
                "v"
            ],
            "commands": [
                ":vsplit"
            ]
        },
        {
            "before": [
                "leader",
                "s"
            ],
            "commands": [
                ":split"
            ]
        },
        {
            // go to references gr
            "before": [
                "g",
                "r"
            ],
            "commands": [
                "editor.action.referenceSearch.trigger"
            ]
        },
        {
            // split the window on the right side
            "before": [
                "leader",
                "%"
            ],
            "commands": [
                "workbench.action.splitEditorRight"
            ]
        },
        {
            // open all the buffers
            "before": [
                "leader",
                ","
            ],
            "commands": [
                "workbench.action.showAllEditors"
            ]
        },
        {
            // "leader+c+r" should rename the a variable like F2 does
            "before": [
                "leader",
                "c",
                "r"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<C-d>"
            ],
            "after": [
                "<C-d>",
                "zz"
            ]
        },
        {
            "before": [
                "<C-u>"
            ],
            "after": [
                "<C-u>",
                "zz"
            ]
        },
        {
            "before": [
                "n"
            ],
            "after": [
                "n",
                "zz",
                "zv"
            ]
        },
        {
            "before": [
                "N"
            ],
            "after": [
                "N",
                "zz",
                "zv"
            ]
        }
    ],
    "window.customTitleBarVisibility": "auto",
    "files.autoSave": "afterDelay",
    "window.titleBarStyle": "custom",
    "git.confirmSync": false,
    "editor.scrollbar.vertical": "hidden",
    "editor.fontFamily": "'JetBrainsMono NF'",
    "animations.Install-Method": "Apc Customize UI++",
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp"
    },
    "FSharp.showExplorerOnStartup": false,
    "workbench.editor.showTabs": "none",
    "dotnet.testWindow.useTestingPlatformProtocol": true,
    "extensions.ignoreRecommendations": true
}